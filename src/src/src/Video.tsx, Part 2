const LightSweep: React.FC<{dur: number}> = ({dur}) => {
  const frame = useCurrentFrame();
  const x = interpolate(frame, [0, dur], [-500, 1500], {
    ...clamp,
    easing: Easing.inOut(Easing.cubic),
  });
  return (
    <AbsoluteFill style={{mixBlendMode: "screen", pointerEvents: "none"}}>
      <div
        style={{
          position: "absolute",
          top: -100,
          bottom: -100,
          left: x,
          width: 360,
          transform: "skewX(-18deg)",
          background:
            "linear-gradient(90deg, rgba(255,178,36,0) 0%, rgba(255,210,120,0.45) 50%, rgba(255,178,36,0) 100%)",
          filter: "blur(8px)",
        }}
      />
    </AbsoluteFill>
  );
};

const rings = (
  p: [number, number],
  color: string,
  from: number,
  to: number,
  frame: number,
) => {
  if (frame < from || frame > to) return null;
  const fade = interpolate(frame, [from, from + 10, to - 10, to], [0, 1, 1, 0], clamp);
  return [0, 15, 30].map((k) => {
    const t = ((frame - from + k) % 45) / 45;
    return (
      <circle
        key={k}
        cx={p[0]}
        cy={p[1]}
        r={8 + t * 80}
        fill="none"
        stroke={color}
        strokeWidth={2.5}
        opacity={(1 - t) * 0.85 * fade}
      />
    );
  });
};

const MapLayer: React.FC = () => {
  const frame = useCurrentFrame();

  const RA = interpolate(
    frame,
    [sec(3), sec(8), sec(15), sec(21.5), sec(28)],
    [0, 150, 330, 580, 900],
    {...clamp, easing: Easing.inOut(Easing.sin)},
  );
  const RB = interpolate(
    frame,
    [sec(15), sec(18), sec(22), sec(26), sec(28)],
    [0, 110, 300, 560, 760],
    {...clamp, easing: Easing.inOut(Easing.sin)},
  );
  const bFactor = interpolate(frame, [sec(27), sec(31)], [1, 0], clamp);
  const dim = interpolate(frame, [sec(28), sec(30), sec(44), sec(46)], [1, 0.3, 0.3, 1], clamp);
  const appear = interpolate(frame, [0, 20], [0, 1], clamp);
  const draw = interpolate(frame, [0, 55], [0, 1], {...clamp, easing: Easing.out(Easing.cubic)});

  const waveOn = frame >= sec(45);
  const ringR = ((frame - sec(45)) * 11) % 1100;

  const mumbaiVis = interpolate(frame, [sec(3), sec(3) + 12, sec(28), sec(29)], [0, 1, 1, 0], clamp);
  const kolkataVis = interpolate(frame, [sec(15.3), sec(15.3) + 12, sec(28), sec(29)], [0, 1, 1, 0], clamp);

  return (
    <svg width={1080} height={960} viewBox="0 0 1080 960">
      <defs>
        <filter id="mapGlow" x="-10%" y="-10%" width="120%" height="120%">
          <feGaussianBlur stdDeviation="5" result="b" />
          <feMerge>
            <feMergeNode in="b" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <g opacity={appear * dim}>
        <path
          d={INDIA_PATH}
          fill={`rgba(255,178,36,${0.05 * draw})`}
          stroke={C.amber}
          strokeOpacity={0.6}
          strokeWidth={2.5}
          strokeLinejoin="round"
          pathLength={1}
          strokeDasharray={1}
          strokeDashoffset={1 - draw}
          filter="url(#mapGlow)"
        />

        {DOTS.map((d, i) => {
          const a = clamp01((RA - d.dA) / 90);
          const b = clamp01((RB - d.dB) / 90) * bFactor;
          const w = waveOn ? clamp01(1 - Math.abs(d.dA - ringR) / 80) : 0;
          const shimmer = 0.88 + 0.12 * Math.sin(frame / 12 + d.ph * 4);
          let fill = "rgba(246,243,236,0.16)";
          let r = 2.1;
          let opacity = 1;
          if (a > 0.02 && b > 0.02) {
            fill = C.violet;
            r = 2.1 + 1.7 * Math.max(a, b);
            opacity = Math.max(a, b) * shimmer;
          } else if (b > 0.02) {
            fill = C.ice;
            r = 2.1 + 1.7 * b;
            opacity = b * shimmer;
          } else if (a > 0.02) {
            fill = C.amber;
            r = 2.1 + 1.7 * a;
            opacity = a * shimmer;
          }
          r += w * 2.4;
          return <circle key={i} cx={d.x} cy={d.y} r={r} fill={fill} opacity={opacity} />;
        })}

        {rings(MUMBAI, C.amber, sec(3), sec(28), frame)}
        {rings(KOLKATA, C.ice, sec(15.3), sec(28), frame)}

        <g opacity={mumbaiVis}>
          <circle cx={MUMBAI[0]} cy={MUMBAI[1]} r={8} fill={C.amber} />
          <text
            x={MUMBAI[0] + 18}
            y={MUMBAI[1] - 14}
            fontFamily={FONT}
            fontWeight={800}
            fontSize={22}
            fill={C.white}
            stroke={C.bg}
            strokeWidth={6}
            paintOrder="stroke"
            letterSpacing={2}
          >
            VILE PARLE · MUMBAI
          </text>
        </g>
        <g opacity={kolkataVis}>
          <circle cx={KOLKATA[0]} cy={KOLKATA[1]} r={8} fill={C.ice} />
          <text
            x={KOLKATA[0] - 16}
            y={KOLKATA[1] - 14}
            textAnchor="end"
            fontFamily={FONT}
            fontWeight={800}
            fontSize={22}
            fill={C.white}
            stroke={C.bg}
            strokeWidth={6}
            paintOrder="stroke"
            letterSpacing={2}
          >
            BRITANNIA
          </text>
        </g>
      </g>
    </svg>
  );
};

const YEAR_KEYS: [number, number][] = [
  [0, 1929],
  [sec(3), 1929],
  [sec(6), 1939],
  [sec(15), 1939],
  [sec(18), 1962],
  [sec(21.5), 1962],
  [sec(23.5), 1982],
  [sec(28), 1982],
  [sec(31), 1995],
  [sec(39.5), 1995],
  [sec(41), 1960],
  [sec(45), 1960],
  [sec(52), 2013],
  [sec(60), 2013],
];

const LABELS: [number, number, string][] = [
  [3, 15, "PARLE GLUCO · THE LAUNCH"],
  [15, 22, "THE COPYCATS ARRIVE"],
  [22, 28, "THE RENAME · PARLE-G"],
  [28, 39.5, "THE RUMOURS"],
  [39.5, 45, "THE REAL ORIGIN"],
  [45, 57, "THE EMPIRE"],
  [57, 60, "YOUR TURN"],
];

const X0 = 90;
const X1 = 990;

const TimelineCounter: React.FC = () => {
  const frame = useCurrentFrame();
  const yearF = interpolate(
    frame,
    YEAR_KEYS.map((k) => k[0]),
    YEAR_KEYS.map((k) => k[1]),
    {...clamp, easing: Easing.inOut(Easing.cubic)},
  );
  const year = Math.round(yearF);
  const appear = interpolate(frame, [sec(3), sec(3) + 18], [0, 1], clamp);
  const rewinding = frame >= sec(39.5) && frame < sec(41.2);
  const jitter = rewinding ? Math.sin(frame * 5) * 8 : 0;
  const color = rewinding ? C.red : C.amber;

  const seg = LABELS.find((l) => frame >= sec(l[0]) && frame < sec(l[1]));
  const labelOpacity = seg
    ? interpolate(frame - sec(seg[0]), [0, 10], [0, 1], clamp)
    : 0;

  const pos = X0 + ((Math.min(2015, Math.max(1925, yearF)) - 1925) / 90) * (X1 - X0);

  return (
    <AbsoluteFill style={{opacity: appear}}>
      <div style={{position: "absolute", left: 0, right: 0, top: 1515, textAlign: "center"}}>
        <div
          style={{
            fontSize: 176,
            fontWeight: 900,
            lineHeight: 1,
            letterSpacing: -4,
            fontVariantNumeric: "tabular-nums",
            color,
            textShadow: `0 0 60px ${rewinding ? "rgba(255,59,48,0.5)" : "rgba(255,178,36,0.45)"}`,
            transform: `translateX(${jitter}px)`,
          }}
        >
          {year}
        </div>
        <div
          style={{
            marginTop: 6,
            fontSize: 28,
            fontWeight: 600,
            letterSpacing: 7,
            color: C.dim,
            opacity: labelOpacity,
          }}
        >
          {seg ? seg[2] : ""}
        </div>
      </div>

      <svg
        width={1080}
        height={70}
        viewBox="0 0 1080 70"
        style={{position: "absolute", left: 0, top: 1770}}
      >
        <defs>
          <filter id="dotGlow" x="-100%" y="-100%" width="300%" height="300%">
            <feGaussianBlur stdDeviation="5" result="b" />
            <feMerge>
              <feMergeNode in="b" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <line x1={X0} x2={X1} y1={27} y2={27} stroke="rgba(255,255,255,0.18)" strokeWidth={4} strokeLinecap="round" />
        <line x1={X0} x2={pos} y1={27} y2={27} stroke={color} strokeWidth={4} strokeLinecap="round" />
        {[1930, 1950, 1970, 1990, 2010].map((y) => {
          const x = X0 + ((y - 1925) / 90) * (X1 - X0);
          return (
            <g key={y}>
              <line x1={x} x2={x} y1={19} y2={35} stroke="rgba(255,255,255,0.35)" strokeWidth={2} />
              <text x={x} y={62} textAnchor="middle" fontFamily={FONT} fontWeight={600} fontSize={22} fill="rgba(255,255,255,0.45)">
                {y}
              </text>
            </g>
          );
        })}
        <circle cx={pos} cy={27} r={10} fill={color} filter="url(#dotGlow)" />
      </svg>
    </AbsoluteFill>
  );
};
