const ACT_BOUNDARIES = [3, 15, 28, 45, 57];

export const Video: React.FC = () => {
  return (
    <AbsoluteFill style={{backgroundColor: C.bg, fontFamily: FONT, overflow: "hidden"}}>
      <Background />

      <div style={{position: "absolute", left: 0, top: 590, width: 1080, height: 960}}>
        <MapLayer />
      </div>

      <Sequence from={0} durationInFrames={sec(3) + OV} name="Hook wrapper">
        <HookArt dur={sec(3) + OV} />
      </Sequence>

      <Sequence from={sec(39.6)} durationInFrames={sec(45) - sec(39.6) + OV} name="Sketch drawing">
        <SketchScene dur={sec(45) - sec(39.6) + OV} />
      </Sequence>

      <Sequence from={sec(48.8)} durationInFrames={sec(52.6) - sec(48.8) + OV} name="Big number">
        <BigNumber dur={sec(52.6) - sec(48.8) + OV} />
      </Sequence>

      <Sequence from={sec(57)} durationInFrames={DURATION - sec(57)} name="CTA art">
        <CtaArt />
      </Sequence>

      {NAMES.map((n, i) => {
        const dur = sec(n.to) - sec(n.from) + OV;
        return (
          <Sequence key={i} from={sec(n.from)} durationInFrames={dur} name={`Name ${i + 1}`}>
            <NameCard caption={n.caption} name={n.name} dur={dur} />
          </Sequence>
        );
      })}

      {LINES.map((l, i) => {
        const from = sec(l.from);
        const isLast = sec(l.to) >= DURATION;
        const dur = Math.min(sec(l.to) - from + OV, DURATION - from);
        return (
          <Sequence key={i} from={from} durationInFrames={dur} name={`Line ${i + 1}`}>
            <LineScene line={l} dur={dur} isLast={isLast} />
          </Sequence>
        );
      })}

      <TimelineCounter />

      {ACT_BOUNDARIES.map((b) => (
        <Sequence key={b} from={sec(b) - 8} durationInFrames={22} name={`Sweep ${b}s`}>
          <LightSweep dur={22} />
        </Sequence>
      ))}

      <FilmOverlay />
    </AbsoluteFill>
  );
};
