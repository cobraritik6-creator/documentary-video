const HookArt: React.FC<{dur: number}> = ({dur}) => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();
  const zoom = interpolate(frame, [0, dur], [1, 1.5], {...clamp, easing: Easing.inOut(Easing.cubic)});
  const enter = spring({frame, fps, config: {damping: 200}});
  const rot = interpolate(frame, [0, dur], [-4, 2], clamp);
  const out = interpolate(frame, [dur - OV, dur], [1, 0], clamp);
  const stamp = spring({
    frame: frame - sec(2.0),
    fps,
    config: {damping: 9, stiffness: 180, mass: 0.7},
  });
  const sheen = interpolate(frame, [0, dur], [-200, 500], clamp);

  return (
    <AbsoluteFill style={{opacity: out}}>
      <div
        style={{
          position: "absolute",
          left: 340,
          top: 690,
          width: 400,
          height: 560,
          transform: `scale(${zoom * (0.85 + 0.15 * enter)}) rotate(${rot}deg)`,
          filter: "drop-shadow(0 50px 60px rgba(0,0,0,0.75))",
        }}
      >
        <WrapperArt sheen={sheen} />
      </div>

      <div
        style={{
          position: "absolute",
          left: 140,
          top: 980,
          width: 800,
          textAlign: "center",
          transform: `rotate(-9deg) scale(${Math.max(0, stamp)})`,
          opacity: clamp01(stamp * 2),
        }}
      >
        <div
          style={{
            display: "inline-block",
            padding: "14px 36px",
            border: `9px solid ${C.red}`,
            borderRadius: 10,
            background: "rgba(0,0,0,0.6)",
            color: C.red,
            fontSize: 56,
            fontWeight: 900,
            lineHeight: 1.05,
            letterSpacing: 2,
          }}
        >
          WO BACCHI
          <br />
          ASLI NAHI HAI
        </div>
      </div>
    </AbsoluteFill>
  );
};

const GirlSketch: React.FC<{progress: number; width: number}> = ({progress, width}) => {
  const part = (a: number, b: number) => 1 - clamp01((progress - a) / (b - a));
  const base = {
    fill: "none",
    stroke: C.white,
    strokeWidth: 3.5,
    strokeLinecap: "round",
    strokeLinejoin: "round",
    pathLength: 1,
    strokeDasharray: 1,
  } as const;
  return (
    <svg width={width} height={(width * 250) / 260} viewBox="70 150 260 250">
      <path d="M200,150 L200,395" stroke={C.amber} strokeOpacity={0.35} strokeWidth={1.5} fill="none" strokeDasharray="6 8" />
      <path d="M72,285 L328,285" stroke={C.amber} strokeOpacity={0.35} strokeWidth={1.5} fill="none" strokeDasharray="6 8" />
      <path d={FACE} {...base} strokeDashoffset={part(0, 0.45)} />
      <path d={FRINGE} {...base} strokeDashoffset={part(0.3, 0.7)} />
      <path d={EYE_L} {...base} strokeDashoffset={part(0.65, 0.8)} />
      <path d={EYE_R} {...base} strokeDashoffset={part(0.7, 0.85)} />
      <path d={MOUTH} {...base} strokeDashoffset={part(0.82, 1)} />
    </svg>
  );
};

