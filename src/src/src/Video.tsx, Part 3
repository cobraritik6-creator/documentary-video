const NameCard: React.FC<{caption: string; name: [string, string]; dur: number}> = ({caption, name, dur}) => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();
  const out = interpolate(frame, [dur - OV, dur], [1, 0], clamp);
  const capIn = spring({frame, fps, config: {damping: 200}});
  const p1 = spring({frame: frame - 6, fps, config: {damping: 11, stiffness: 140, mass: 0.6}});
  const p2 = spring({frame: frame - 11, fps, config: {damping: 11, stiffness: 140, mass: 0.6}});
  const c1 = interpolate(frame, [38, 46], [0, 1], {...clamp, easing: Easing.out(Easing.cubic)});
  const c2 = interpolate(frame, [44, 52], [0, 1], {...clamp, easing: Easing.out(Easing.cubic)});
  const shake = frame >= 38 && frame < 52 ? Math.sin(frame * 2.4) * (1 - c2) * 14 : 0;
  const nameDim = interpolate(frame, [44, 56], [1, 0.45], clamp);

  const lineStyle = (p: number): React.CSSProperties => ({
    opacity: clamp01(p * 1.5),
    transform: `scale(${interpolate(p, [0, 1], [2, 1])})`,
  });

  return (
    <AbsoluteFill style={{opacity: out}}>
      <div style={{position: "absolute", left: 40, right: 40, top: 520, textAlign: "center"}}>
        <div
          style={{
            fontSize: 44,
            fontWeight: 600,
            letterSpacing: 2,
            color: C.dim,
            opacity: capIn,
            transform: `translateY(${(1 - capIn) * 30}px)`,
            marginBottom: 24,
          }}
        >
          {caption}
        </div>
        <div
          style={{
            position: "relative",
            display: "inline-block",
            padding: "10px 40px",
            transform: `translateX(${shake}px)`,
            opacity: nameDim,
          }}
        >
          <div style={{fontSize: 128, fontWeight: 900, lineHeight: 0.98, letterSpacing: -3, textShadow: "0 6px 40px rgba(0,0,0,0.85)"}}>
            <div style={lineStyle(p1)}>{name[0]}</div>
            <div style={lineStyle(p2)}>{name[1]}</div>
          </div>
          <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            style={{position: "absolute", left: 0, top: 0, width: "100%", height: "100%", overflow: "visible"}}
          >
            <path d="M0,0 L100,100" stroke={C.red} strokeWidth={14} strokeLinecap="round" vectorEffect="non-scaling-stroke" fill="none" pathLength={1} strokeDasharray={1} strokeDashoffset={1 - c1} />
            <path d="M100,0 L0,100" stroke={C.red} strokeWidth={14} strokeLinecap="round" vectorEffect="non-scaling-stroke" fill="none" pathLength={1} strokeDasharray={1} strokeDashoffset={1 - c2} />
          </svg>
        </div>
      </div>
    </AbsoluteFill>
  );
};

const BigNumber: React.FC<{dur: number}> = ({dur}) => {
  const frame = useCurrentFrame();
  const {fps} = useVideoConfig();
  const t = Easing.out(Easing.cubic)(clamp01(frame / 55));
  const value = Math.round(5000 * t);
  const s = spring({frame, fps, config: {damping: 14, stiffness: 120}});
  const out = interpolate(frame, [dur - OV, dur], [1, 0], clamp);
  return (
    <AbsoluteFill style={{opacity: out * clamp01(s * 2)}}>
      <div
        style={{
          position: "absolute",
          top: 760,
          left: 0,
          right: 0,
          textAlign: "center",
          transform: `scale(${0.8 + 0.2 * s})`,
        }}
      >
        <div style={{fontSize: 40, fontWeight: 800, letterSpacing: 8, color: C.dim}}>RETAIL SALES · 2013</div>
        <div
          style={{
            fontSize: 260,
            fontWeight: 900,
            color: C.amber,
            lineHeight: 1,
            letterSpacing: -8,
            fontVariantNumeric: "tabular-nums",
            textShadow: "0 0 90px rgba(255,178,36,0.55)",
          }}
        >
          <span style={{fontSize: 150}}>₹</span>
          {value.toLocaleString("en-US")}
        </div>
        <div style={{fontSize: 96, fontWeight: 900, letterSpacing: 16}}>CRORE</div>
        <div style={{marginTop: 22, fontSize: 24, fontWeight: 600, color: C.dim, letterSpacing: 2}}>
          Source: Wikipedia · Parle Products
        </div>
      </div>
    </AbsoluteFill>
  );
};

